# Telegram bot token for the orchestrator's own control panel.
MASTER_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to operate the control panel.
ADMIN_IDS=111111111,222222222

# Directory that holds one subdirectory per managed project.
# Defaults to ./projects next to the application package.
PROJECTS_ROOT_DIR=

# Directory for orchestrator-private state: the SQLite database and the master key.
# Never place this inside PROJECTS_ROOT_DIR. Defaults to ./state.
STATE_DIR=

# Optional explicit paths. Both default to locations inside STATE_DIR.
DATABASE_PATH=
MASTER_KEY_PATH=

# Base64 url-safe encoded 32-byte key used to encrypt stored secrets.
# Leave empty to have one generated into MASTER_KEY_PATH on first launch.
# Set it explicitly when the state directory is not durable across deployments.
ORCHESTRATOR_MASTER_KEY=

# Sandbox used to isolate projects: auto, bubblewrap, docker or native.
# auto probes bubblewrap, then docker, then falls back to native.
# native provides no filesystem isolation and is intended for development only.
ISOLATION_BACKEND=auto

# Image used by the docker isolation backend.
CONTAINER_IMAGE=python:3.12-slim

# Start projects marked for autostart when the orchestrator boots.
AUTOSTART_PROJECTS=true

# Optional GitHub OAuth App client ID, enabling one-tap account linking through
# GitHub's device flow instead of pasting a personal access token.
# Register an OAuth App at https://github.com/settings/developers, enable
# "Device Flow" under its settings, and paste its client ID here.
# Leave empty to fall back to a token-creation link with the scope pre-filled.
GITHUB_OAUTH_CLIENT_ID=
